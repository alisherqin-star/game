c","x":151,"y":41,"room":8},{"t":"c","x":153,"y":41,"room":8},{"t":"c","x":155,"y":41,"room":8},{"t":"c","x":128,"y":32,"room":9},{"t":"c","x":135,"y":32,"room":9},{"t":"f","x":123,"y":36,"room":9},{"t":"f","x":133,"y":36,"room":9},{"t":"p","x":124,"y":41,"room":9},{"t":"p","x":141,"y":41,"room":9},{"t":"p","x":125,"y":45,"room":10},{"t":"p","x":138,"y":45,"room":10},{"t":"c","x":123,"y":49,"room":10},{"t":"c","x":140,"y":49,"room":10},{"t":"p","x":131,"y":50,"room":10},{"t":"*","x":132,"y":54,"room":10},{"t":"c","x":107,"y":33,"room":11},{"t":"f","x":99,"y":38,"room":11},{"t":"p","x":100,"y":40,"room":11},{"t":"p","x":114,"y":40,"room":11},{"t":"h","x":106,"y":41,"room":11},{"t":"M","x":82,"y":40,"room":12},{"t":"2","x":54,"y":36,"room":13},{"t":"!","x":50,"y":38,"room":13,"text":"路牌：岩缝里嵌着雷之石！伊布碰到它就会进化成雷伊布，冲过草原尽头的电网。"},{"t":"s","x":61,"y":38,"room":13},{"t":"c","x":342,"y":4,"room":14},{"t":"c","x":344,"y":4,"room":14},{"t":"c","x":346,"y":4,"room":14},{"t":"c","x":348,"y":4,"room":14},{"t":"c","x":350,"y":4,"room":14},{"t":"v","x":353,"y":7,"room":14},{"t":"v","x":353,"y":21,"room":14},{"t":"c","x":347,"y":23,"room":14},{"t":"v","x":352,"y":31,"room":14},{"t":"c","x":343,"y":35,"room":14},{"t":"c","x":346,"y":35,"room":14},{"t":"c","x":349,"y":35,"room":14},{"t":"s","x":340,"y":38,"room":14},{"t":"!","x":344,"y":38,"room":14,"text":"石碑：雷电塔。风暴那晚之后，塔里的电网就一直失控，只有雷伊布能穿过。一直往上爬，塔顶供奉着一颗火之石。"},{"t":"h","x":359,"y":38,"room":14},{"t":"c","x":388,"y":4,"room":15},{"t":"c","x":390,"y":4,"room":15},{"t":"c","x":392,"y":4,"room":15},{"t":"v","x":376,"y":6,"room":15},{"t":"v","x":398,"y":6,"room":15},{"t":"3","x":402,"y":9,"room":15},{"t":"s","x":364,"y":10,"room":15},{"t":"!","x":372,"y":10,"room":15,"text":"石碑：火之石就供奉在大厅尽头。让伊布碰到它，伊布就会进化成浑身火焰的火伊布。"},{"t":"f","x":389,"y":10,"room":15},{"t":"T","x":191,"y":31,"room":0,"text":"古代石板（其五）：「冷风从湖北的冰缝里吹出。霜雪覆盖的巨石，在那里等待伊布。」"},{"t":"T","x":171,"y":38,"room":0,"text":"古代石板（其一）：「蔚蓝之石，映着池水的光。触碰它的伊布，会生出鱼鳍与长尾。」"},{"t":"o","x":235,"y":36,"room":1,"text":"food_1_blueberry|吃了一颗蓝莓，酸酸甜甜的。……伊布没有进化。看来进化可不是靠吃东西的。"},{"t":"T","x":252,"y":30,"room":2,"text":"古代石板（其八）：「解开一颗心结，换来一条缎带。哭泣的，未必是敌人。」"},{"t":"T","x":249,"y":16,"room":3,"text":"古代石板（其六）：「与伙伴在烈日下并肩作战。羁绊满溢时，额前会浮现红玉。」"},{"t":"T","x":286,"y":34,"room":4,"text":"古代石板（其七）：「与伙伴在月光下并肩作战。羁绊满溢时，周身会浮现金环。」"},{"t":"T","x":319,"y":40,"room":6,"text":"古代石板（其二）：「黄绿之石，困着一声惊雷。它嵌在湖水尽头的岩缝里。」"},{"t":"T","x":330,"y":17,"room":7,"text":"古代石板（其三）：「赤红之石，供奉在高塔之巅。电网之后，火焰之前。」"},{"t":"T","x":314,"y":25,"room":7,"text":"古代石板（其四）：「荆棘烧尽之处，青苔覆着巨石。伊布在它身旁醒来，耳尖冒出了嫩叶。」"},{"t":"o","x":393,"y":10,"room":15,"text":"food_3_chili|咬了一口辣椒！伊布辣得直吐舌头……但还是没有进化。火之石就在大厅尽头。"},{"t":"k","x":217,"y":38,"room":1,"text":"1|slimes"},{"t":"V","x":177,"y":38,"room":0,"text":"grandma|home"},{"t":"V","x":188,"y":38,"room":0,"text":"scholar|home"},{"t":"V","x":205,"y":38,"room":0,"text":"trainer|home"},{"t":"g","x":261,"y":36,"room":2},{"t":"C","x":278,"y":34,"room":4,"text":"leaf"},{"t":"V","x":270,"y":38,"room":4,"text":"grandma|lost"},{"t":"g","x":310,"y":38,"room":5},{"t":"C","x":317,"y":17,"room":7,"text":"bell"},{"t":"V","x":56,"y":36,"room":13,"text":"trainer|lost"},{"t":"C","x":352,"y":4,"room":14,"text":"magnet"},{"t":"g","x":356,"y":38,"room":14},{"t":"V","x":376,"y":10,"room":15,"text":"scholar|lost"}],"start":{"x":185,"y":38},"deco":[{"k":"forest_tree_0","x":2728,"y":624},{"k":"env_village_home_elder","x":2824,"y":624},{"k":"env_planter","x":2920,"y":624},{"k":"forest_tree_1","x":3000,"y":624},{"k":"env_fence","x":3048,"y":624},{"k":"env_village_home_guide","x":3144,"y":624},{"k":"env_bench","x":3256,"y":624},{"k":"env_berry_bush","x":3288,"y":624},{"k":"env_village_home_merchant","x":3360.0,"y":624},{"k":"forest_tree_2","x":3432,"y":624},{"k":"forest_tree_0","x":3560,"y":624},{"k":"forest_tree_1","x":3768,"y":624},{"k":"env_berry_bush","x":3828,"y":624},{"k":"forest_tree_2","x":3880,"y":624},{"k":"env_stump","x":4008,"y":624},{"k":"env_berry_bush","x":4136,"y":624},{"k":"forest_tree_0","x":4168,"y":416},{"